# ---------------------------------------------------------------------------
# Ollama Cloud (recommended) — a frontier-scale model on their hardware.
#
# Free tier: sign in at https://ollama.com, then create a key under Settings →
# API keys. Nothing is charged and no card is required.
#
# With this set, your analysis payload (tickers, positions, prices) is sent to
# ollama.com. Leave it blank and the app uses a local model instead, in which
# case nothing leaves your machine.
# ---------------------------------------------------------------------------
OLLAMA_API_KEY=

# Which cloud model to use. gpt-oss:120b is a good default: far stronger than
# anything that runs on a laptop, and light enough for the free tier.
OLLAMA_CLOUD_MODEL=gpt-oss:120b

# --- Local fallback (used only when no cloud key is set) -------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=3072

# --- Behaviour -------------------------------------------------------------
CACHE_TTL_SECONDS=900
REQUEST_TIMEOUT=20
LLM_TIMEOUT=180
RISK_FREE_FALLBACK=0.04

# Set to 1 when deploying to a server used by more than one person. Storage
# then lives in the browser session instead of on disk, so one visitor's
# holdings are never served to another.
STOCK_ANALYZER_SHARED=
